# docker-compose.prod.yml 用の環境変数(社内向け・Google Workspace SSOあり構成)
# コピーして .env.production を作成し、実際の値を設定してください。
# 使い方: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# 使用するOllamaモデル(タグ)
MODEL_NAME=gemma4

# Google Cloud ConsoleでOAuthクライアント(Webアプリケーション)を作成して取得する値
# 承認済みのリダイレクトURIには OAUTH2_PROXY_REDIRECT_URL と同じ値を登録すること
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# oauth2-proxyのCookie暗号化キー(32バイトをbase64url化した文字列)
# 生成例: python3 -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
OAUTH2_PROXY_COOKIE_SECRET=xxxxxxxx

# ログインを許可する自社のGoogle Workspaceドメイン(例: example.co.jp)
ALLOWED_EMAIL_DOMAIN=example.co.jp

# 社員がアクセスするURLに合わせたコールバックURL
OAUTH2_PROXY_REDIRECT_URL=https://llm.internal.example.co.jp/oauth2/callback
